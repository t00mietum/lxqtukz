From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: t00mietum <73576036+t00mietum@users.noreply.github.com>
Date: Mon, 12 Oct 2026 21:48:59 -0700
Subject: [PATCH] liblxqt: take the settings directory name from
 LXQT_CONFIG_NAME

LXQt::Settings files live in $XDG_CONFIG_HOME/lxqt/ and, for defaults,
in <dir>/lxqt/ for each $XDG_CONFIG_DIRS entry. The 'lxqt' part was a
literal, so a second LXQt-based desktop on the same machine had to share
every setting with stock LXQt.

LXQT_CONFIG_NAME now names that directory. Unset, empty, or anything
that is not a plain directory name keeps the old 'lxqt', so stock
sessions behave exactly as before.

LXQtukz sets it to 'lxqtukz' in its session launcher, which puts all
user settings in ~/.config/lxqtukz/ and all system settings in
/etc/xdg/lxqtukz/.
---
 lxqtsettings.cpp | 22 +++++++++++++++++++++-
 1 file changed, 21 insertions(+), 1 deletion(-)

diff --git a/lxqtsettings.cpp b/lxqtsettings.cpp
index 5617baebd43d3b562d18091ff2755d6cc0953909..bbacb2394543e31839770c6e4c28e70bd5f9effd 100644
--- a/lxqtsettings.cpp
+++ b/lxqtsettings.cpp
@@ -26,6 +26,8 @@
  *
  * END_COMMON_COPYRIGHT_HEADER */
 
+/* Modified 2026 for LXQtukz: configurable configuration directory name. */
+
 #include "lxqtsettings.h"
 #include <QDebug>
 #include <QEvent>
@@ -41,6 +43,24 @@
 
 using namespace LXQt;
 
+namespace
+{
+// The directory name under $XDG_CONFIG_HOME and each $XDG_CONFIG_DIRS entry
+// that has every module's settings. LXQT_CONFIG_NAME lets a distribution
+// keep its desktop's settings apart from a stock LXQt on the same machine.
+// Read once: changing it mid-process would split one module across two dirs.
+QString configName()
+{
+    static const QString name = [] {
+        const QString fromEnv = qEnvironmentVariable("LXQT_CONFIG_NAME");
+        if (fromEnv.isEmpty() || fromEnv.contains(QLatin1Char('/')) || fromEnv.startsWith(QLatin1Char('.')))
+            return QStringLiteral("lxqt");
+        return fromEnv;
+    }();
+    return name;
+}
+}
+
 class LXQt::SettingsPrivate
 {
 public:
@@ -111,7 +131,7 @@ public:
 
  ************************************************/
 Settings::Settings(const QString& module, QObject* parent) :
-    QSettings(QStringLiteral("lxqt"), module, parent),
+    QSettings(configName(), module, parent),
     d_ptr(new SettingsPrivate(this))
 {
 }
