##	Test box: the build box plus what it takes to run our apps on a headless
##	Wayfire. Kept apart so the release build never sees a system Wayfire or
##	the QML runtime modules.

ARG BASE=lxqtukz-build-debian13
FROM ${BASE}

ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
	wayfire grim shellcheck libgl1-mesa-dri libegl-mesa0 mesa-vulkan-drivers fonts-dejavu-core \
	qt6-wayland qml6-module-qtquick qml6-module-qtquick-controls qml6-module-qtquick-layouts \
	qml6-module-qtquick-window qml6-module-qtquick-templates qml6-module-qtqml-workerscript \
	qml6-module-qtquick-dialogs qml6-module-org-kde-desktop lxqt-qtplugin \
	qterminal xwayland xclip wl-clipboard x11-apps \
	swaybg psmisc xdg-desktop-portal gtklock gtklock-userinfo-module librsvg2-common swayidle \
	&& rm -rf /var/lib/apt/lists/*
